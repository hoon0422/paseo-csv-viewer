{
  "name": "paseo-csv-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only CSV and TSV exploration in a Paseo workspace panel",
  "files": ["paseo-plugin.json", "OVERVIEW.md", "npm-shrinkwrap.json", "index.client.tsx", "index.server.ts", "client/", "server/", "shared/", "assets/"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --tsconfig tests/tsconfig.json --test tests/*.test.ts*",
    "check": "npm run typecheck && node scripts/build-child.mjs --check",
    "build": "node scripts/build-child.mjs",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.6-r.2"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.12.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "esbuild": "0.28.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-web": "^0.21.2",
    "react-test-renderer": "19.1.0",
    "react-native": "0.81.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
